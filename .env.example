# ---------------------------------------------------------------------------
# Trading Universe environment configuration
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Safety interlocks (spec 22.3) ----------------------------------------
# TRADING_ENV must be REAL *and* ALLOW_REAL_ORDERS must be true before any
# real-money order can be constructed. Both default to the safe value.
TRADING_ENV=PAPER
ALLOW_REAL_ORDERS=false

# Operating mode: ADVISORY | PAPER_AUTO | LIVE_AUTO
TU_OPERATING_MODE=ADVISORY

# --- Data source mode ------------------------------------------------------
# DEMO  -> deterministic synthetic data, no external calls, runs offline
# LIVE  -> Moomoo OpenD + SEC + GDELT + disclosures
TU_DATA_MODE=DEMO

# --- Moomoo OpenD ----------------------------------------------------------
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PWD=
MOOMOO_PAPER_ACCOUNT_ID=

# --- External APIs ---------------------------------------------------------
# SEC requires a descriptive User-Agent with contact info per their fair-use policy.
SEC_USER_AGENT=TradingUniverse/0.1 (your.email@example.com)
MARKETAUX_API_KEY=

# --- Sentiment -------------------------------------------------------------
# lexicon | finbert   (finbert requires: pip install -e '.[nlp]')
TU_SENTIMENT_ENGINE=lexicon

# --- Storage ---------------------------------------------------------------
TU_DATABASE_URL=sqlite:///./db/trading.sqlite

# --- Server ----------------------------------------------------------------
TU_API_HOST=127.0.0.1
TU_API_PORT=8000
TU_CORS_ORIGINS=http://localhost:3000
